{
  "manifest_version": 3,
  "name": "Auri–Orion Audio Recorder",
  "version": "0.2.0",
  "description": "Graba el audio de una pestaña con controles separados: Iniciar, Pausar, PARAR sin descargar y Guardar audio.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Auri–Orion Audio Recorder",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Iniciar o parar la grabación sin descargar automáticamente"
    }
  }
}
